# ---- Backend LLM (vLLM / llama.cpp / TGI, API OpenAI-compatible) ----
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-30B-A3B

# ---- Finestra di contesto: DEVE combaciare con --max-model-len di vLLM ----
CONTEXT_WINDOW=32768
MAX_OUTPUT_TOKENS=1024

# ---- Compattazione (il punto dove si rompeva la chat) ----
COMPACTION_TRIGGER_RATIO=0.75
COMPACTION_TARGET_RATIO=0.45
KEEP_RECENT_MESSAGES=6
MIN_MESSAGES_TO_COMPACT=4
MAX_SUMMARY_INPUT_TOKENS=6000
SUMMARY_MAX_TOKENS=700

# ---- Rete / robustezza ----
REQUEST_TIMEOUT_S=180
CONNECT_TIMEOUT_S=10
MAX_RETRIES=3

# ---- Persistenza ----
DB_PATH=./data/chat.db

# ---- Agenti / OSINT ----
TOOL_OUTPUT_MAX_CHARS=6000
MAX_TOOL_ITERATIONS=6
TOOL_TIMEOUT_S=30
SEARXNG_URL=
